{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.mjs?__vpath=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
